# ==========================================
# Princeton DSA - Standard .gitignore
# ==========================================

# --- Java Compiled Artifacts & Libraries ---
*.class
*.jar
*.war
*.ear

# --- Build Directories ---
bin/
build/
out/
target/

# --- Heavy Test Data & Datasets (Bỏ qua data nặng) ---
algs4-data/
data/
*.txt
*.csv
*.png
*.gif

# --- Coursera & Princeton Specifics ---
*.zip
*.tar.gz
*.rar
.lift/
.checkstyle
.spotbugs

# --- IDEs & Editors ---
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# --- OS Generated Files ---
.DS_Store
Thumbs.db